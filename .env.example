# External/self-hosted AI video worker (Wan / ComfyUI adapter)
AI_VIDEO_API_URL=
AI_VIDEO_API_KEY=

# Optional external/self-hosted voice worker (Tamil / English TTS adapter)
AI_VOICE_API_URL=
AI_VOICE_API_KEY=

# Optional default background music URL mixed into the final video
DEFAULT_BACKGROUND_MUSIC_URL=

# Supabase Storage used for direct browser uploads of logos, screenshots and source clips.
# Use a dedicated PUBLIC bucket, for example: ai-video-assets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=ai-video-assets

